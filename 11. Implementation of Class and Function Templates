#include <iostream>
using namespace std;

template <class T>
class Sample
{
    T a, b;

public:
    Sample(T x, T y)
    {
        a = x;
        b = y;
    }

    void display()
    {
        cout << "First value = " << a << endl;
        cout << "Second value = " << b << endl;
    }
};

template <class T>
T maximum(T a, T b)
{
    return (a > b) ? a : b;
}

int main()
{
    int x, y;

    cout << "Enter two numbers: ";
    cin >> x >> y;

    Sample<int> s(x, y);
    s.display();

    cout << "Maximum value = " << maximum(x, y);

    return 0;
}
